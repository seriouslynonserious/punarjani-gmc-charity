# Sites runtime values: configure through the hosting dashboard, never public/config.json.
APPS_SCRIPT_URL=https://script.google.com/macros/s/REPLACE/exec
APPS_SCRIPT_SECRET=replace-with-at-least-32-random-bytes
CHALLENGE_SECRET=replace-with-a-different-32-byte-secret
ADMIN_EMAILS=approved-admin@example.org
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/REPLACE/edit

# Optional alternative Vercel deployment uses api/index.mjs instead of server/worker.mjs.
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
ALLOWED_ORIGINS=https://your-site.example
TURNSTILE_SECRET=replace-with-private-turnstile-key
TURNSTILE_HOSTNAMES=your-site.example
